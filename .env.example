# API 配置
# 支持 OpenAI 或任何兼容 OpenAI API 格式的服务

# OpenAI API Key (必填)
OPENAI_API_KEY=your-api-key-here

# API 基础地址 (可选，默认为 https://api.openai.com/v1)
# 如果使用 DeepSeek，设置为: https://api.deepseek.com/v1
# 如果使用其他代理服务，请设置为对应的地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 默认使用的模型 (可选)
# 支持的模型: gpt-3.5-turbo, gpt-4, deepseek-chat 等
DEFAULT_MODEL=gpt-3.5-turbo

# Flask 配置
FLASK_ENV=development
FLASK_PORT=5000