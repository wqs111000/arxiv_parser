# API 配置
# 支持 OpenAI 或任何兼容 OpenAI API 格式的服务

# OpenAI API Key (必填)
OPENAI_API_KEY=your-api-key-here

# API 端点 (可选，默认 OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1

# 摘要生成模型 (可选)
DEFAULT_MODEL=gpt-3.5-turbo

# 全文分析模型 (可选，需支持文件上传，默认 qwen-long)
FULL_ANALYSIS_MODEL=qwen-long

# 如果使用 DeepSeek，取消注释下面两行
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# 如果使用阿里云百炼，取消注释下面两行
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_MODEL=qwen-plus

# DashScope 全文分析配置 (可选，未设置时回退到 OPENAI_API_KEY)
# DASHSCOPE_API_KEY=your-dashscope-key-here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 全文分析文件处理等待超时，单位秒 (可选，默认 300)
# FA_POLL_TIMEOUT=300

# Flask 配置
FLASK_PORT=5000

# 安全配置
# 生产环境必须设置强随机值，可用以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
